#!/usr/bin/env bash
# Impala 대화형 SQL 셸. bin/impala-query -i 와 같다.
#
# 저장소를 pip로 설치하지 않고 쓰기 때문에, 이 스크립트가 소스 위치를 찾아
# 파이썬에 넘겨준다. 다른 인터프리터를 쓰려면 PYTHON 환경변수로 지정한다.
# 크론에서는 PATH 가 좁으므로 python3 이 /usr/bin 밖에 있으면 지정해야 한다.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(dirname "$here")"

# 크론에서 돌 때를 위한 설정.
#
# - PYTHONIOENCODING: 크론은 LANG 없이 실행되는 경우가 많다. 그러면 파이썬이
#   출력 인코딩을 ascii 로 잡아 한글을 출력하는 순간 UnicodeEncodeError 로 죽는다.
# - PYTHONUNBUFFERED: 출력을 파일로 넘길 때 버퍼에 갇히지 않게 한다. 진행 상황이
#   작업이 끝난 뒤에야 한꺼번에 나오는 것을 막고, 중간에 죽어도 로그가 남는다.
export PYTHONIOENCODING="${PYTHONIOENCODING:-utf-8}"
export PYTHONUNBUFFERED="${PYTHONUNBUFFERED:-1}"

# --help 에 실제로 친 명령 이름이 나오게 한다
export PROG_NAME="bin/impala-shell"

exec "${PYTHON:-python3}" "$root/src/impala_query.py" --interactive "$@"
